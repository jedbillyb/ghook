# Discord webhook URL (from channel settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# GitHub webhook secret (set the same value when creating the webhook on GitHub)
GITHUB_WEBHOOK_SECRET=your_random_secret_here

# Port the server listens on
PORT=3000

# Whether to forward notifications for private repositories.
# Private repos are skipped by default. Set to "true" to opt in.
NOTIFY_PRIVATE_REPOS=false

# Discord rendering uses Components V2 by default.
# Uncomment and set to "true" to fall back to classic embeds. Useful while
# Components V2 is still server-gated by Discord and not yet available on
# the server hosting your webhook (V2 messages fail silently otherwise).
# DISCORD_LEGACY_EMBEDS=true

# Footer text shown at the bottom of each message. Override this when
# self-hosting to point users to your own fork. WEBHOOK_FOOTER_URL controls
# the link target rendered in Components V2 mode. Set either to an empty
# value to drop it; the relative timestamp is kept either way.
# WEBHOOK_FOOTER=github.com/jedbillyb/ghook
# WEBHOOK_FOOTER_URL=https://github.com/jedbillyb/ghook

# Comma-separated list of GitHub event names to drop entirely.
# Example: silence stars and forks.
# IGNORED_EVENTS=watch,fork

# Comma-separated list of branch name patterns. When set, push/create/delete
# events whose branch does not match any pattern are dropped. Tag refs always
# pass through. "*" matches a single path segment, so "release/*" matches
# "release/v1" but not "release/v1/hotfix".
# BRANCH_FILTER=main,develop,release/*

# Multi-webhook routing (optional). Define extra webhooks as
# DISCORD_WEBHOOK_<NAME>, then map GitHub events to them via ROUTES.
# Rules are evaluated left to right; first match wins. Events with no
# matching rule fall back to DISCORD_WEBHOOK_URL.
# DISCORD_WEBHOOK_RELEASES=https://discord.com/api/webhooks/.../...
# DISCORD_WEBHOOK_CI=https://discord.com/api/webhooks/.../...
# DISCORD_WEBHOOK_ISSUES=https://discord.com/api/webhooks/.../...
# ROUTES=release:RELEASES,workflow_run:CI,issues:ISSUES,issue_comment:ISSUES

# Path-based routing for push events (optional). Maps changed file paths to the
# same named webhooks as ROUTES. A push is routed by the first rule whose
# pattern matches any file touched by the push, so ordering matters. "*"
# matches a single path segment, "**" matches across segments. Path rules are
# evaluated before ROUTES; pushes matching none fall through to ROUTES and then
# to DISCORD_WEBHOOK_URL. Useful in monorepos where each area has its own
# channel.
#
# Webhook delivery only. The Events API used for WATCH_REPOS, WATCH_ORGS and
# WATCH_USERS omits file lists from its push payloads, so polled events cannot
# be matched on path and fall through to ROUTES. ghook warns at startup if
# PATH_ROUTES is set while any polled target is configured.
#
# GitHub also caps the webhook commits array at 20 and omits it entirely on
# very large pushes, so a push above that size is matched on a partial file
# list, or on none at all.
# DISCORD_WEBHOOK_API=https://discord.com/api/webhooks/.../...
# DISCORD_WEBHOOK_WEB=https://discord.com/api/webhooks/.../...
# PATH_ROUTES=packages/api/**:API,packages/web/**:WEB

# Message language. Defaults to "en". Supported values: "en", "fr".
# Only the static strings ghook itself renders (titles, field labels,
# statuses) are translated — commit messages, issue titles and other
# user-authored content are always passed through unchanged.
# LOCALE=fr

# Polling - watch repos, orgs, and users (optional)
# ghook polls GitHub's Events API for each target on a timer.
# No GitHub App installation required on the target side, which also makes
# this the way to follow a repository you can read but cannot administer.
# Private repos additionally need NOTIFY_PRIVATE_REPOS=true and a
# GITHUB_TOKEN whose account has read access; without both, their events
# are fetched and then dropped.
#
# Targets are separated by ";". An optional per-target event filter follows
# ":" as a comma-separated list of GitHub event names. Omit the filter to
# receive all events from that target.
#
# WATCH_REPOS=torvalds/linux:release,push;vercel/next.js
# WATCH_ORGS=vercel:release
# WATCH_USERS=gaearon
#
# Polling interval in milliseconds. Default: 60000 (60s).
# POLL_INTERVAL=60000
#
# Personal access token for GitHub API auth. Optional but strongly
# recommended - raises the rate limit from 60 to 5000 requests per hour.
# Needs no special scopes for public repos.
# GITHUB_TOKEN=ghp_xxxx
